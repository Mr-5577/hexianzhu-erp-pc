# 环境变量模板（新项目初始化参考此文件创建 .env.development / .env.test / .env.production）
# ⚠️ 无引号的值不能加行内注释（dotenv 会把注释当作值的一部分），注释请单独成行

# 系统标题（按环境区分，会显示在浏览器标题与登录页）
VITE_APP_TITLE='XX管理系统'

# 接口前缀（经过 vite proxy 代理，与 vite.config.ts 中 proxy 配置对应）
VITE_API_BASE_URL='/api'

# 接口实际地址（vite proxy target，本地联调改这里）
VITE_API_BASE_URL_ACTUAL='http://127.0.0.1:8080'

# 附件前缀地址
VITE_ANNEX_BASE_URL='http://127.0.0.1:9090'

VITE_APP_VERSION='1.0.0'

# 是否开启调试
VITE_ENABLE_DEBUG=true

# 是否启用 mock
VITE_ENABLE_MOCK=true
